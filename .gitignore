data/dota_yolo/
data/annot_aux/
data/seg_kf01c/

# ---- 轻量结构化数据（保留目录占位） ----
data/osm/
!data/osm/*.json

# ---- IDE / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 导出与杂项 ----
