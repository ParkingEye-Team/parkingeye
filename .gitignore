# ---- 环境 / 依赖 / 密钥 ----
.venv/
.wheels/
__pycache__/
*.py[cod]
*.egg-info/
.env
.env.*
!.env.example

# ---- 训练与推理产物（ml/ 下与仓库根的历史位置都忽略） ----
runs/
runs_train_log.txt
ml/runs/
ml/runs_train_log.txt
*.pt
*.cache
# 训练/推理终端日志（体积大，属过程产物）
dota_resume_log.txt
seg_night_log.txt
ge_finetune_log.txt
ge_ft_v2_log.txt
ge_ft_v3_log.txt
ds_probe_out.txt

# ---- 遥感影像数据（卫星原始影像及伴生文件不入库；仅保留顶层成果预览 PNG） ----
data/imagery/*
!data/imagery/*.png
data/dota_yolo/
data/annot_aux/
data/seg_kf01c/
data/seg_kf01c_manual/
data/seg_manual/

# ---- GE 截图与派生数据集（原图版权归 Google，不入库；标注 JSON 可另存） ----
data/ge_annot/raw/
data/ge_yolo/
data/ge_yolo_tiled/

# ---- 推理过程产物（叠加图/预览大图不入库） ----
data/infer/

# ---- JL1 域预标注工作台：保留 README，切片与预标注 JSON 不入库（由脚本 20 可重建） ----
data/jl1_annot/*/images/
data/jl1_annot/*/preannot_raw/
data/jl1_annot/*/work/

# ---- 容量估计产物：保留轻量成果（CSV/GeoJSON/JSON），忽略大图 ----
# 用户填写的真值/工作副本/备份不入库（可能含个人信息）
data/capacity/truth_collection_filled*.csv
data/capacity/truth_collection_work_*.csv
data/capacity/backup/
data/capacity/compare_*/
data/capacity/*.png
data/capacity/*.jpg
!data/capacity/*_small.jpg

# ---- 轻量结构化数据（保留目录占位） ----
data/osm/
!data/osm/*.json
# 高德 POI：仅限项目内部使用，按平台条款不公开分发/入库（23 号脚本可重建）
data/poi/

# ---- IDE / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 导出与杂项 ----
*.zip
*.log

# ---- 本地文档归档（不追踪；过期计划/旧快照） ----
doc/archive/
